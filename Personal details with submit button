
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </title>Personal Information</title>
</head>
<body>
    <form action="">
        <fieldset>
            <legend> UserPersonal Information</legend>
            <label for="name">Enter your fullName:</label><br>
            <input type="text" name="name"><br><br>

            <label for="email">Enter your Email:</label><br>
            <input type="email" id="email" name="email"><br><br>

            <label for="age">Enter your password:</label><br>
            <input type="password" id="age" name="age"><br><br>
             <label for="age">Confirm your password:</label><br>
            <input type="password" id="age" name="age"><br><br>

            <label for="">Enter your gender:</label>
